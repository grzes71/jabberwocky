---
import latestData from '../data/latest.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { name: 'Home', href: `${base}/` },
  { name: 'Game', href: `${base}/game` },
  { name: 'World Explorer', href: `${base}/world` },
  { name: 'Objects', href: `${base}/objects` },
  { name: 'Gallery', href: `${base}/gallery` },
  { name: 'Music & Sound', href: `${base}/music` },
  { name: 'Memory', href: `${base}/memory` },
  { name: 'Technical', href: `${base}/technical` },
  { name: 'Releases', href: `${base}/releases` },
  { name: 'History', href: `${base}/history` },
];
---

<header class="sticky top-0 z-40 bg-fantasy-surface/90 backdrop-blur-md border-b border-fantasy-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand Logo -->
      <a href={`${base}/`} class="flex items-center space-x-3 group">
        <div class="w-9 h-9 rounded bg-fantasy-surfaceLight border border-fantasy-gold/50 flex items-center justify-center group-hover:border-fantasy-flame transition-colors shadow-fantasy-gold">
          <!-- Stylized Dragon Icon SVG -->
          <svg class="w-6 h-6 text-fantasy-flame" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 16h-2v-2h2v2zm0-4h-2V7h2v7z" class="hidden" />
            <path d="M4 14l3-6 4 3 4-7 5 10-5 3-4-2-4 3-3-4z" />
          </svg>
        </div>
        <div>
          <span class="font-cinzel text-xl font-bold tracking-wider text-fantasy-gold group-hover:text-fantasy-flame transition-colors">
            JABBERWOCKY
          </span>
          <span class="hidden sm:inline-block ml-2 text-xs px-1.5 py-0.5 rounded bg-fantasy-surfaceLight text-fantasy-phosphor border border-fantasy-phosphor/30">
            {latestData.tag_name}
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden xl:flex items-center space-x-1">
        {navItems.map((item) => {
          const isActive = (item.href === `${base}/` && pathname === base) || (item.href !== `${base}/` && pathname.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 text-xs uppercase tracking-wider rounded transition-all duration-150 ${
                isActive
                  ? 'bg-fantasy-gold/20 text-fantasy-gold border border-fantasy-gold/50 font-bold shadow-fantasy-gold'
                  : 'text-fantasy-muted hover:text-fantasy-text hover:bg-fantasy-surfaceLight'
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- CTA & Mobile Menu Toggle -->
      <div class="flex items-center space-x-3">
        <a
          href={latestData.download_url}
          class="hidden sm:inline-flex items-center space-x-2 px-3 py-1.5 text-xs font-bold uppercase tracking-wider rounded bg-fantasy-flame text-black hover:bg-yellow-400 transition-colors shadow-fantasy-flame"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
          <span>Download XEX</span>
        </a>

        <!-- Mobile hamburger button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="xl:hidden p-2 rounded text-fantasy-muted hover:text-white hover:bg-fantasy-surfaceLight focus:outline-none"
          aria-label="Toggle navigation menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden xl:hidden border-t border-fantasy-border bg-fantasy-surface px-4 pt-2 pb-4 space-y-1">
    {navItems.map((item) => {
      const isActive = (item.href === `${base}/` && pathname === base) || (item.href !== `${base}/` && pathname.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`block px-3 py-2 text-sm uppercase tracking-wider rounded transition-colors ${
            isActive
              ? 'bg-fantasy-gold/20 text-fantasy-gold border border-fantasy-gold/40 font-bold'
              : 'text-fantasy-muted hover:text-white hover:bg-fantasy-surfaceLight'
          }`}
        >
          {item.name}
        </a>
      );
    })}
    <div class="pt-2">
      <a
        href={latestData.download_url}
        class="w-full flex items-center justify-center space-x-2 px-4 py-2 text-sm font-bold uppercase rounded bg-fantasy-flame text-black hover:bg-yellow-400 transition-colors"
      >
        <span>Download XEX ({latestData.version})</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>

